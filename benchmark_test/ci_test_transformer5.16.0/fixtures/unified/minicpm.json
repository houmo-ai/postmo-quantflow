{
  "config": {
    "architectures": [
      "LlamaForCausalLM"
    ],
    "attention_bias": false,
    "attention_dropout": 0.0,
    "bos_token_id": 1,
    "dtype": "bfloat16",
    "eos_token_id": 2,
    "head_dim": 16,
    "hidden_act": "silu",
    "hidden_size": 64,
    "initializer_range": 0.02,
    "intermediate_size": 128,
    "max_position_embeddings": 128,
    "mlp_bias": false,
    "model_type": "llama",
    "num_attention_heads": 4,
    "num_hidden_layers": 2,
    "num_key_value_heads": 2,
    "pad_token_id": null,
    "pretraining_tp": 1,
    "rms_norm_eps": 1e-06,
    "rope_parameters": {
      "rope_theta": 10000.0,
      "rope_type": "default"
    },
    "tie_word_embeddings": false,
    "transformers_version": "5.16.1",
    "use_cache": true,
    "vocab_size": 512
  },
  "tokenizer": {
    "vocab": {
      "<s>": 1,
      "</s>": 2,
      "<unk>": 0,
      "[UNK]": 3,
      "hello": 4,
      "world": 5,
      "test": 6,
      "calibration": 7,
      "OCR:": 8,
      "42": 9,
      "你好": 10
    },
    "special_tokens": {
      "bos_token": "<s>",
      "eos_token": "</s>",
      "unk_token": "<unk>"
    }
  },
  "processor_files": {}
}
