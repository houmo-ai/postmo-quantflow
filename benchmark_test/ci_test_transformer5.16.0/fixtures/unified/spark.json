{
  "config": {
    "architectures": [
      "Spark2_5ForCausalLM"
    ],
    "model_type": "spark2_5",
    "vocab_size": 512,
    "hidden_size": 256,
    "intermediate_size": 512,
    "num_hidden_layers": 6,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "head_dim": 64,
    "headwise_attn_output_gate": true,
    "gate_attn_act_mode": "sigmoid",
    "hidden_act": "gelu",
    "sliding_window": 8,
    "layer_types": [
      "sliding_attention",
      "sliding_attention",
      "sliding_attention",
      "full_attention",
      "sliding_attention",
      "sliding_attention"
    ],
    "max_position_embeddings": 128,
    "rope_parameters": {
      "sliding_attention": {
        "rope_theta": 10000,
        "partial_rotary_factor": 1.0
      },
      "full_attention": {
        "rope_theta": 5000000,
        "partial_rotary_factor": 0.25
      }
    },
    "tie_word_embeddings": true,
    "bos_token_id": 2,
    "eos_token_id": 1,
    "pad_token_id": 0
  },
  "tokenizer": {
    "vocab": {
      "[UNK]": 0,
      "[EOS]": 1,
      "[BOS]": 2,
      "hello": 3,
      "world": 4,
      "test": 5,
      "calibration": 6
    },
    "special_tokens": {
      "bos_token": "[BOS]",
      "eos_token": "[EOS]",
      "pad_token": "[UNK]"
    }
  },
  "processor_files": {}
}
