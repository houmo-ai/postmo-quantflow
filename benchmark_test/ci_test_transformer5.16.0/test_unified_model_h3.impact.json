{
  "version": 1,
  "rules": [
    {
      "id": "unified-native-h3",
      "patterns": [
        "xhmodel_merak/model_integrations/h3/**",
        "xhmodel_merak/model_integrations/sol_h3/source.py",
        "xhmodel_merak/model_integrations/sol_h3/artifact.py",
