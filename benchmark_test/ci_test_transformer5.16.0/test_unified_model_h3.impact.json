        "examples_merak/aigc/h3/**",
        "benchmark_test/ci_test_transformer5.16.0/test_h3_native_build.py",
        "benchmark_test/ci_test_transformer5.16.0/test_sol_h3_native_lora.py",
        "benchmark_test/ci_test_transformer5.16.0/test_sol_h3_reference_vae.py",
        "benchmark_test/ci_test_transformer5.16.0/test_qwen_image21_feature_encoder.py",
