        "xhmodel_merak/model_inference/**",
        "xhmodel_merak/model_catalog/**",
        "xhmodel_merak/model_artifact/**",
        "xhmodel_merak/_requirements.py",
        "xhmodel_merak/_environment.py",
        "xhmodel_merak/model_integrations/__init__.py",
        "xhmodel_merak/model_integrations/_shared.py",
        "xhmodel_merak/model_integrations/_dependencies.py",
        "xhmodel_merak/workflows/**"
