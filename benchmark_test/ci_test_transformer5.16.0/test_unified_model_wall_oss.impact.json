{
  "version": 1,
  "rules": [
    {
      "id": "wall-oss-unified",
      "patterns": [
        "xhmodel_merak/model_integrations/wall_oss/**",
        "xhmodel_merak/xh_other_model/models/wall_oss/**",
        "configs_merak/workflows/xh2a/other_models/wall_oss/**",
        "examples_merak/vla/wall_oss/**"
      ]
    },
    {
      "id": "wall-oss-unified-common",
      "patterns": [
        "xhmodel_merak/model_build/**",
        "xhmodel_merak/model_inference/**",
        "xhmodel_merak/model_catalog/**",
        "xhmodel_merak/model_artifact/**",
        "xhmodel_merak/_requirements.py",
        "xhmodel_merak/_environment.py",
        "xhmodel_merak/model_integrations/autoregressive/**",
        "xhmodel_merak/xh_llm/workflows/**",
        "xhmodel_merak/workflows/**",
        "xhmodel_merak/model_integrations/__init__.py",
        "xhmodel_merak/model_integrations/_shared.py",
        "xhmodel_merak/model_integrations/_dependencies.py"
      ]
    },
    {
      "id": "wall-oss-fixtures",
      "patterns": [
        "benchmark_test/ci_test_transformer5.16.0/_unified_cases.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_e2e_worker.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_fixtures/__init__.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_fixtures/wall_oss.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_preparation.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_runner.py",
        "benchmark_test/ci_test_transformer5.16.0/_unified_small_model.py"
      ]
    }
  ]
}
